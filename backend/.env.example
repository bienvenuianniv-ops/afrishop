# ================================
# AFRISHOP — Variables d'environnement (modèle)
# Copiez ce fichier en .env et remplissez vos vraies valeurs.
# Ne jamais committer le fichier .env réel.
# ================================

# Serveur
PORT=3000
NODE_ENV=development

# Base de données MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=afrishop_db

# Sécurité — générez une valeur unique avec :
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# CORS — domaines autorisés en cross-origin, séparés par des virgules (vide = permissif en dev)
ALLOWED_ORIGINS=

# Paiements
WAVE_API_KEY=
ORANGE_MONEY_API_KEY=
PAYDUNYA_API_KEY=
PAYPAL_CLIENT_ID=

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
